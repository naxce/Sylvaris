#!/usr/bin/env bash
set -euo pipefail

dir="${SYLVARIS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/sylvaris}"

usage() {
    cat <<'EOF'
Usage: sylvaris [command]

  (no command)             start the shell
  center [toggle|open|close]  control SylCenter (default: toggle)
  view <name>                 open SylCenter on a view (theme opens SylTheme)
  theme [toggle|open|close|next|prev|apply]  control SylTheme (default: toggle)
  state                    print the shell state as JSON
EOF
}

call() {
    exec qs -p "$dir" ipc call sylvaris "$@"
}

case "${1:-}" in
"")
    exec qs -p "$dir" -n
    ;;
center)
    action="${2:-toggle}"
    case "$action" in
    toggle | open | close) ;;
    *)
        echo "sylvaris: unknown action '$action'" >&2
        exit 2
        ;;
    esac
    call "$action" center
    ;;
theme)
    action="${2:-toggle}"
    case "$action" in
    toggle | open | close)
        call "$action" theme
        ;;
    next | prev | apply)
        call theme "$action"
        ;;
    *)
        echo "sylvaris: unknown action '$action'" >&2
        exit 2
        ;;
    esac
    ;;
view)
    if [ -z "${2:-}" ]; then
        usage >&2
        exit 2
    fi
    call view "$2"
    ;;
state)
    call state
    ;;
-h | --help)
    usage
    ;;
*)
    echo "sylvaris: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
